{
  "version": 1,
  "description": "Golden outputs for client-side data handling. Every Thoth SDK must reproduce `expected` byte for byte (compare as canonical JSON). `expected_omitted` means the field is not sent at all.",
  "format": {
    "hash": "\"hmac-sha256:\" + lowercase hex of HMAC-SHA256(key = UTF-8 bytes of salt, message = UTF-8 bytes of canonical JSON of the value)",
    "canonical_json": "keys sorted by Unicode code point, separators ',' and ':' with no spaces, non-ASCII characters not escaped, strings escaped as JSON requires",
    "tool_arguments.hash": "keys and structure kept; every leaf except null replaced by its hash; null stays null",
    "tool_arguments.redact": "keys and structure kept; every leaf, null included, replaced by \"<redacted>\"",
    "tool_arguments.drop": "tool_args omitted from the request",
    "prompt.hash": "the whole value replaced by one hash; null stays null",
    "prompt.drop": "the field is omitted",
    "context": "in a context dict, the value under a prompt-bearing key (spelling-insensitive: lowercase, '_' and '-' removed, matched against the list below) at any depth gets the prompts mode (hash or omitted); any other string longer than 512 characters becomes its hash (hash mode) or \"<redacted>\" (drop mode); everything else is kept",
    "context_prompt_keys": [
      "comment",
      "completion",
      "content",
      "conversation",
      "conversationcontext",
      "conversationinputtext",
      "conversationoutputtext",
      "description",
      "goal",
      "history",
      "input",
      "inputtext",
      "instruction",
      "instructions",
      "message",
      "messages",
      "note",
      "notes",
      "output",
      "prompt",
      "prompts",
      "query",
      "question",
      "response",
      "summary",
      "systemprompt",
      "task",
      "text",
      "tooloutput",
      "toolresult",
      "transcript",
      "usermessage",
      "userprompt"
    ],
    "bounds": "the root is depth 0; a value deeper than depth 16 is replaced by \"<truncated>\"; at most 5000 values are visited, after which a dict gains \"_truncated\": \"<truncated>\" and a list ends with \"<truncated>\"",
    "salt": "client-held string; golden cases use the salt in each case"
  },
  "cases": [
    {
      "name": "args/flat_strings/hash",
      "kind": "tool_arguments",
      "mode": "hash",
      "salt": "golden-salt-v1",
      "input": {
        "to": "alice@example.com",
        "subject": "Quarterly numbers"
      },
      "expected": {
        "to": "hmac-sha256:bf8a0dc3bf9ec6f1c64cbe369d94579e29bdbf1660639992118b01257ddb0c4d",
        "subject": "hmac-sha256:a13d80d25159fa07fdb7141e151d32365d6834d98d8fcfd8dee766ffb8154f65"
      }
    },
    {
      "name": "args/flat_strings/redact",
      "kind": "tool_arguments",
      "mode": "redact",
      "salt": "golden-salt-v1",
      "input": {
        "to": "alice@example.com",
        "subject": "Quarterly numbers"
      },
      "expected": {
        "to": "<redacted>",
        "subject": "<redacted>"
      }
    },
    {
      "name": "args/flat_strings/drop",
      "kind": "tool_arguments",
      "mode": "drop",
      "salt": "golden-salt-v1",
      "input": {
        "to": "alice@example.com",
        "subject": "Quarterly numbers"
      },
      "expected_omitted": true
    },
